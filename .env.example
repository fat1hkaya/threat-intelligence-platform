# Kopyalayıp .env olarak kaydedin. .env git'e gönderilmez.
# SQL Server (2019+ gerekir; 2022 Developer önerilir)
TL_DB_SERVER=localhost
# Express kullanıyorsanız: TL_DB_SERVER=localhost\SQLEXPRESS
TL_DB_NAME=ThreatLens
# Boş bırakılırsa Windows kimlik doğrulaması (Trusted_Connection) kullanılır
TL_DB_USER=
TL_DB_PASSWORD=
# Boş bırakılırsa kurulu en yeni "ODBC Driver 18/17 for SQL Server" seçilir
TL_DB_DRIVER=
TL_SESSION_HOURS=12
# abuse.ch (ThreatFox, MalwareBazaar, URLhaus) ücretsiz anahtar: https://auth.abuse.ch
ABUSECH_AUTH_KEY=
